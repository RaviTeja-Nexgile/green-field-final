@model CareClinicManager.ViewModels.Admin.DepartmentFormViewModel
@{
    ViewData["Title"] = "Edit specialization";
}

<div class="card mx-auto" style="max-width: 560px;">
    <div class="card-body">
        <h1 class="h4 mb-4">Edit specialization</h1>

        <form asp-action="EditSpecialization" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Specializations" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
