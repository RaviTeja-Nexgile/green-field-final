@model CareClinicManager.ViewModels.Receptionist.AppointmentListViewModel
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Appointments</h1>
    <div>
        <a asp-action="Calendar" class="btn btn-outline-primary me-2">Calendar</a>
        <a asp-action="Book" class="btn btn-primary">Book appointment</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Department</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Appointments)
                    {
                        <tr>
                            <td>@a.PatientName</td>
                            <td>@a.DoctorName</td>
                            <td>@a.DepartmentName</td>
                            <td>@a.Date.ToString("yyyy-MM-dd")</td>
                            <td>@a.Time.ToString(@"hh\:mm")</td>
                            <td><span class="badge @BadgeClass(a.Status)">@a.Status</span></td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                @if (a.Status == "Scheduled")
                                {
                                    <form asp-action="CheckIn" asp-route-id="@a.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Check in</button>
                                    </form>
                                    <form asp-action="Cancel" asp-route-id="@a.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    string BadgeClass(string status) => status switch
    {
        "Scheduled" => "badge-status-Scheduled",
        "Checked in" => "badge-status-Checked-in",
        "In progress" => "badge-status-In-progress",
        "Completed" => "badge-status-Completed",
        "Cancelled" => "badge-status-Cancelled",
        _ => "badge-status-Scheduled"
    };
}
