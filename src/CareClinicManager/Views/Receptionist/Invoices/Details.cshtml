@model CareClinicManager.ViewModels.Receptionist.InvoiceDetailsViewModel
@{
    ViewData["Title"] = $"Invoice #{Model.Invoice.Id}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/invoices.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Invoice #@Model.Invoice.Id</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to invoices</a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Patient</dt>
                    <dd class="col-sm-8">@Model.Invoice.Patient?.Name</dd>

                    <dt class="col-sm-4">Items</dt>
                    <dd class="col-sm-8">@Model.Invoice.Items</dd>

                    <dt class="col-sm-4">Total amount</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Invoice.TotalAmount.ToString("C")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.Invoice.Status == "Paid" ? "badge-status-Paid" : "badge-status-Unpaid")">@Model.Invoice.Status</span>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">Payments</div>
            <div class="card-body">
                @if (!Model.Invoice.Payments.Any())
                {
                    <p class="text-muted mb-0">No payments recorded.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Date</th><th>Amount</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Invoice.Payments)
                            {
                                <tr>
                                    <td>@payment.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@payment.Amount.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-header">Record payment</div>
            <div class="card-body">
                @if (Model.Invoice.Status == "Paid")
                {
                    <p class="text-success mb-0">This invoice is already paid.</p>
                }
                else
                {
                    <form asp-action="RecordPayment" method="post">
                        <input type="hidden" asp-for="Payment.InvoiceId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Payment.Amount" class="form-label">Amount</label>
                            <input asp-for="Payment.Amount" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Payment.Amount" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Record payment</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
