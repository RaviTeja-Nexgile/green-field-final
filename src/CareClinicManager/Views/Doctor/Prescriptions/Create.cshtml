@model CareClinicManager.ViewModels.Doctor.PrescriptionFormViewModel

@{
    ViewData["Title"] = "New prescription";
}

<div class="prescriptions-page">
    <div class="mb-3">
        <h1 class="h3 mb-1">New prescription</h1>
        <p class="text-muted mb-0">Patient: @Model.PatientName</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post" class="prescription-form">
                <input type="hidden" asp-for="MedicalRecordId" />
                <input type="hidden" asp-for="ConsultationId" />
                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="PatientName" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MedicineId" class="form-label"></label>
                    <select asp-for="MedicineId" class="form-select" asp-items="@(new SelectList(Model.Medicines, "Id", "Name"))">
                        <option value="">-- Choose a medicine --</option>
                    </select>
                    <span asp-validation-for="MedicineId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Dosage" class="form-label"></label>
                    <input asp-for="Dosage" class="form-control" placeholder="e.g. 500 mg twice daily" />
                    <span asp-validation-for="Dosage" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save prescription</button>
                    <a asp-action="Index" asp-route-medicalRecordId="@Model.MedicalRecordId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/prescriptions.css" asp-append-version="true" />
}
